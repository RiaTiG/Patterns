<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import javafx.collections.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<TabPane xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.View">
    <!-- Первая вкладка -->
    <Tab text="Student List">
        <VBox spacing="10" style="-fx-padding: 10;">
            <!-- Расширенная область фильтрации -->
            <GridPane hgap="5" vgap="5">
                <!-- Фамилия -->
                <Label text="ФИО:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                <TextField fx:id="nameFilterField" promptText="Иванов И.И." GridPane.columnIndex="1" GridPane.rowIndex="0" />
                <!-- Гит -->
                <Label text="GIT:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                <HBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="1">
                    <ComboBox fx:id="gitFilterBox">
                        <items>
                            <FXCollections fx:factory="observableArrayList">
                                <String fx:value="Не важно" />
                                <String fx:value="Да" />
                                <String fx:value="Нет" />
                            </FXCollections>
                        </items>
                        <value>Не важно</value>
                    </ComboBox>
                    <TextField fx:id="gitSearchField" disable="true" promptText="GIT-ссылка" />
                </HBox>
                <!-- Почта -->
                <Label text="Почта:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                <HBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="2">
                    <ComboBox fx:id="emailFilterBox">
                        <items>
                            <FXCollections fx:factory="observableArrayList">
                                <String fx:value="Не важно" />
                                <String fx:value="Да" />
                                <String fx:value="Нет" />
                            </FXCollections>
                        </items>
                        <value>Не важно</value>
                    </ComboBox>
                    <TextField fx:id="emailSearchField" disable="true" promptText="example@mail.com" />
                </HBox>
                <!-- Телефон -->
                <Label text="Телефон:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                <HBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="3">
                    <ComboBox fx:id="phoneFilterBox">
                        <items>
                            <FXCollections fx:factory="observableArrayList">
                                <String fx:value="Не важно" />
                                <String fx:value="Да" />
                                <String fx:value="Нет" />
                            </FXCollections>
                        </items>
                        <value>Не важно</value>
                    </ComboBox>
                    <TextField fx:id="phoneSearchField" disable="true" promptText="+7XXXXXXXXXX" />
                </HBox>
                <!-- Телеграмм -->
                <Label text="Telegram:" GridPane.columnIndex="0" GridPane.rowIndex="4" />
                <HBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="4">
                    <ComboBox fx:id="telegramFilterBox">
                        <items>
                            <FXCollections fx:factory="observableArrayList">
                                <String fx:value="Не важно" />
                                <String fx:value="Да" />
                                <String fx:value="Нет" />
                            </FXCollections>
                        </items>
                        <value>Не важно</value>
                    </ComboBox>
                    <TextField fx:id="telegramSearchField" disable="true" promptText="@username" />
                </HBox>
            <columnConstraints>
               <ColumnConstraints />
               <ColumnConstraints />
            </columnConstraints>
            <rowConstraints>
               <RowConstraints />
               <RowConstraints />
               <RowConstraints />
               <RowConstraints />
               <RowConstraints />
            </rowConstraints>
            </GridPane>
            <!-- Таблица студентов -->
            <TableView fx:id="studentTable" onMouseClicked="#onTableSelectionChanged" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="nameColumn" text="Name" />
                    <TableColumn fx:id="gitColumn" text="GIT" />
                    <TableColumn fx:id="contactColumn" text="Contact" />
                </columns>
                <HBox spacing="10">
                    <Button onAction="#onAddStudent" text="Add Student" />
                    <Button onAction="#onRemoveStudent" text="Remove Selected" />
                </HBox>
            </TableView>
            <!-- Панель с кнопками страницы -->
            <HBox alignment="CENTER" spacing="10">
                <Button onAction="#onPreviousPage" text="Предыдущая" />
                <Label text="Страница:" />
                <Label fx:id="currentPageLabel" text="1" />
                <Label text="из" />
                <Label fx:id="totalPagesLabel" text="1" />
                <Button onAction="#onNextPage" text="Следующая" />
            </HBox>
            <!-- Область управления -->
            <HBox alignment="CENTER" spacing="10">
                <Button fx:id="addButton" onAction="#onAdd" text="Добавить" />
                <Button fx:id="editButton" disable="true" onAction="#onEdit" text="Изменить" />
                <Button fx:id="deleteButton" disable="true" onAction="#onDelete" text="Удалить" />
                <Button fx:id="refreshButton" onAction="#onRefresh" text="Обновить" />
            </HBox>
        </VBox>
    </Tab>
    <!-- Остальные вкладки -->
    <Tab text="Tab 2">
        <Label text=" " />
    </Tab>
    <Tab text="Tab 3">
        <Label text=" " />
    </Tab>
</TabPane>
